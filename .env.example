# Backend Environment Variables
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///clouddeploy.db

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload & Workspace Configuration
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_EXTRACTED_SIZE_BYTES=104857600
MAX_FILE_COUNT=1000
WORKSPACE_DIR=backend/workspaces

# Docker Deployment Configuration
LOGS_DIR=backend/logs
PORT_RANGE_START=8001
PORT_RANGE_END=8050
CONTAINER_MEMORY_LIMIT=256m
CONTAINER_CPUS_LIMIT=0.5
CONTAINER_PIDS_LIMIT=100
DEPLOYMENT_HEALTHCHECK_TIMEOUT_SECONDS=30
